print("Welcome to the Nail Polish Matcher!")

while True:
    print("1. Pick a color.")
    print("2. Match skin tone.")
    
    selection = input("Please enter your choice (1 or 2): ")
    
    if selection == "1":
        color = input("What is your preferred color? ")
        print("You have selected " + color + ".")
        
    elif selection == "2":
        tone = input("Enter your skin tone (Warm, Cool, or Neutral). Type 'Unknown' if you are unsure: ")
        
        if tone == "Unknown":
            print("Since you aren't sure, we recommend 'Neutral' for you!")
            tone = "Neutral"
            
        chosen_color = input("What color would you like to wear? ")
        
        if tone == "Warm" and chosen_color == "Blue":
            print("Error: That color may not be the best match for a Warm skin tone.")
        else:
            print("Great choice! " + chosen_color + " looks good with " + tone + " tones.")

    repeat = input("Would you like to pick again? (Yes/No): ")
    if repeat == "No":
        break

print("Thank you for using our program")
